# Local terraform directories
.terraform/

# Terraform lock file and other hidden files
.terraform*

# State files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables
*.tfvars
*.tfvars.json

# Ignore variables for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include the .terraformrc or terraform.rc files
.terraformrc
terraform.rc
